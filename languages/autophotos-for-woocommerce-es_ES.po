msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active."
msgstr "AutoPhotos for WooCommerce requiere que WooCommerce esté instalado y activo."

msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active. The plugin has been deactivated."
msgstr "AutoPhotos for WooCommerce requiere que WooCommerce esté instalado y activo. El plugin se ha desactivado."

msgid "Not allowed."
msgstr "No permitido."

msgid "Missing pairing code."
msgstr "Falta el código de emparejamiento."

msgid "AutoPhotos rejected the pairing request."
msgstr "AutoPhotos rechazó la solicitud de emparejamiento."

msgid "AutoPhotos.ai (connected %s)"
msgstr "AutoPhotos.ai (conectado %s)"

msgid "AutoPhotos"
msgstr "AutoPhotos"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Disconnecting…"
msgstr "Desconectando…"

msgid "Paste a pairing code first."
msgstr "Pega primero un código de emparejamiento."

msgid "AutoPhotos for WooCommerce"
msgstr "AutoPhotos for WooCommerce"

msgid "Connected to AutoPhotos.ai since %s."
msgstr "Conectado a AutoPhotos.ai desde %s."

msgid "Process product photos from your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos panel</a>."
msgstr "Procesa las fotos de tus productos desde tu <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">panel de AutoPhotos</a>."

msgid "Disconnect"
msgstr "Desconectar"

msgid "Generate a pairing code on your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos account</a> and paste it below to connect this store — no need to create WooCommerce REST API keys by hand."
msgstr "Genera un código de emparejamiento en tu <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">cuenta de AutoPhotos</a> y pégalo abajo para conectar esta tienda, sin necesidad de crear claves REST API de WooCommerce manualmente."

msgid "Pairing code"
msgstr "Código de emparejamiento"

msgid "Connect"
msgstr "Conectar"

