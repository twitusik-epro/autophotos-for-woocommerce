msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active."
msgstr "AutoPhotos for WooCommerce nécessite que WooCommerce soit installé et activé."

msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active. The plugin has been deactivated."
msgstr "AutoPhotos for WooCommerce nécessite que WooCommerce soit installé et activé. L'extension a été désactivée."

msgid "Not allowed."
msgstr "Non autorisé."

msgid "Missing pairing code."
msgstr "Code de jumelage manquant."

msgid "AutoPhotos rejected the pairing request."
msgstr "AutoPhotos a refusé la demande de jumelage."

msgid "AutoPhotos.ai (connected %s)"
msgstr "AutoPhotos.ai (connecté %s)"

msgid "AutoPhotos"
msgstr "AutoPhotos"

msgid "Connecting…"
msgstr "Connexion…"

msgid "Disconnecting…"
msgstr "Déconnexion…"

msgid "Paste a pairing code first."
msgstr "Veuillez d'abord coller un code de jumelage."

msgid "AutoPhotos for WooCommerce"
msgstr "AutoPhotos for WooCommerce"

msgid "Connected to AutoPhotos.ai since %s."
msgstr "Connecté à AutoPhotos.ai depuis le %s."

msgid "Process product photos from your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos panel</a>."
msgstr "Traitez les photos de vos produits depuis votre <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">panneau AutoPhotos</a>."

msgid "Disconnect"
msgstr "Déconnecter"

