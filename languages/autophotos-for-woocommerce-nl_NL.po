msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active."
msgstr "AutoPhotos for WooCommerce vereist dat WooCommerce is geïnstalleerd en actief is."

msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active. The plugin has been deactivated."
msgstr "AutoPhotos for WooCommerce vereist dat WooCommerce is geïnstalleerd en actief is. De plugin is gedeactiveerd."

msgid "Not allowed."
msgstr "Niet toegestaan."

msgid "Missing pairing code."
msgstr "Koppelcode ontbreekt."

msgid "AutoPhotos rejected the pairing request."
msgstr "AutoPhotos heeft het koppelverzoek geweigerd."

msgid "AutoPhotos.ai (connected %s)"
msgstr "AutoPhotos.ai (verbonden %s)"

msgid "AutoPhotos"
msgstr "AutoPhotos"

msgid "Connecting…"
msgstr "Verbinden…"

msgid "Disconnecting…"
msgstr "Verbinding verbreken…"

msgid "Paste a pairing code first."
msgstr "Plak eerst een koppelcode."

msgid "AutoPhotos for WooCommerce"
msgstr "AutoPhotos for WooCommerce"

msgid "Connected to AutoPhotos.ai since %s."
msgstr "Verbonden met AutoPhotos.ai sinds %s."

msgid "Process product photos from your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos panel</a>."
msgstr "Verwerk productfoto's vanuit je <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos-paneel</a>."

msgid "Disconnect"
msgstr "Verbinding verbreken"

msgid "Generate a pairing code on your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos account</a> and paste it below to connect this store — no need to create WooCommerce REST API keys by hand."
msgstr "Genereer een koppelcode in je <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos-account</a> en plak deze hieronder om deze winkel te koppelen — geen handmatige WooCommerce REST API-sleutels nodig."

msgid "Pairing code"
msgstr "Koppelcode"

msgid "Connect"
msgstr "Koppelen"

