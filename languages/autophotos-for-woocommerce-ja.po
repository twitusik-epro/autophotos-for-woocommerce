msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active."
msgstr "AutoPhotos for WooCommerce の利用には WooCommerce のインストールと有効化が必要です。"

msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active. The plugin has been deactivated."
msgstr "AutoPhotos for WooCommerce の利用には WooCommerce のインストールと有効化が必要です。プラグインは無効化されました。"

msgid "Not allowed."
msgstr "許可されていません。"

msgid "Missing pairing code."
msgstr "ペアリングコードがありません。"

msgid "AutoPhotos rejected the pairing request."
msgstr "AutoPhotos がペアリングリクエストを拒否しました。"

msgid "AutoPhotos.ai (connected %s)"
msgstr "AutoPhotos.ai(接続日: %s)"

msgid "AutoPhotos"
msgstr "AutoPhotos"

msgid "Connecting…"
msgstr "接続中…"

msgid "Disconnecting…"
msgstr "切断中…"

msgid "Paste a pairing code first."
msgstr "先にペアリングコードを貼り付けてください。"

msgid "AutoPhotos for WooCommerce"
msgstr "AutoPhotos for WooCommerce"

msgid "Connected to AutoPhotos.ai since %s."
msgstr "%s から AutoPhotos.ai に接続されています。"

msgid "Process product photos from your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos panel</a>."
msgstr "<a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos パネル</a>から商品写真を処理できます。"

msgid "Disconnect"
msgstr "接続解除"

msgid "Generate a pairing code on your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos account</a> and paste it below to connect this store — no need to create WooCommerce REST API keys by hand."
msgstr "<a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos アカウント</a>でペアリングコードを生成し、以下に貼り付けてこのストアを接続してください。WooCommerce の REST API キーを手動で作成する必要はありません。"

msgid "Pairing code"
msgstr "ペアリングコード"

msgid "Connect"
msgstr "接続"

