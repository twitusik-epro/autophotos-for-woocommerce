msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active."
msgstr "AutoPhotos for WooCommerce erfordert, dass WooCommerce installiert und aktiv ist."

msgid "AutoPhotos for WooCommerce requires WooCommerce to be installed and active. The plugin has been deactivated."
msgstr "AutoPhotos for WooCommerce erfordert, dass WooCommerce installiert und aktiv ist. Das Plugin wurde deaktiviert."

msgid "Not allowed."
msgstr "Nicht erlaubt."

msgid "Missing pairing code."
msgstr "Kopplungscode fehlt."

msgid "AutoPhotos rejected the pairing request."
msgstr "AutoPhotos hat die Kopplungsanfrage abgelehnt."

msgid "AutoPhotos.ai (connected %s)"
msgstr "AutoPhotos.ai (verbunden %s)"

msgid "AutoPhotos"
msgstr "AutoPhotos"

msgid "Connecting…"
msgstr "Verbindung wird hergestellt…"

msgid "Disconnecting…"
msgstr "Verbindung wird getrennt…"

msgid "Paste a pairing code first."
msgstr "Bitte zuerst einen Kopplungscode einfügen."

msgid "AutoPhotos for WooCommerce"
msgstr "AutoPhotos for WooCommerce"

msgid "Connected to AutoPhotos.ai since %s."
msgstr "Verbunden mit AutoPhotos.ai seit %s."

msgid "Process product photos from your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos panel</a>."
msgstr "Bearbeite Produktfotos über dein <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos-Panel</a>."

msgid "Disconnect"
msgstr "Trennen"

msgid "Generate a pairing code on your <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos account</a> and paste it below to connect this store — no need to create WooCommerce REST API keys by hand."
msgstr "Erzeuge einen Kopplungscode in deinem <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">AutoPhotos-Konto</a> und füge ihn unten ein, um diesen Shop zu verbinden — ganz ohne manuell WooCommerce-REST-API-Schlüssel zu erstellen."

msgid "Pairing code"
msgstr "Kopplungscode"

msgid "Connect"
msgstr "Verbinden"

